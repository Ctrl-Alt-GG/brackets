# A template: the nginx image's entrypoint fills in ${API_ORIGIN}, which
# /docker-entrypoint.d/05-bracket-runtime-config.envsh works out from API_BASE_URL.

# Vite fingerprints the file names in /assets/, so those files never change. Everything else, such
# as index.html, is revalidated on every load, so a new release reaches every browser at once.
map $uri $bracket_cache_control {
    default "no-cache";
    /runtime-config.js "no-store";
    ~^/assets/ "public, max-age=31536000, immutable";
}

server {
    listen 8080;
    listen [::]:8080;

    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;

    # All headers are set here: a location that adds a header of its own drops all of these.
    # Styles may be inline because the toasts inject theirs at runtime. Scripts may not: the
    # session cookie is HttpOnly, but an injected script could still send requests with it and act
    # as the signed-in organizer.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ${API_ORIGIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header Cache-Control $bracket_cache_control always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
